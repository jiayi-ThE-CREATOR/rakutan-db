__pycache__/
*.pyc
.DS_Store
.venv/
venv/

# 取得したHTMLのキャッシュ（巨大なのでコミットしない）
data/raw/

# 「公開できるデータ」と「公開できないデータ」を分ける（2026-08-15 政岡さんの指摘）。
# 以前この2つを1つのルールで守ろうとして、KOANの事実だけの courses.json まで
# git で運べなくなっていた。
#
# data/courses.json … シラバス原文と教員名を含む生データ。公開リポジトリには置かない
# data/reviews.json … 口コミの生データ。学生の書いた文章なので置かない
#   ただし集約ずみ（data/reviews.agg.json）は追跡する。中身は built.json に
#   載せているものと同じで、追加で公開されるものは無い。これが無いと
#   生データを持っている人しか同じ数字を再現できない。
# web/data/courses.built.json … build.py が原文を落として書き出す公開用。これは追跡する
data/courses.json
data/reviews.json
# data/syllabus_text.jsonl.gz … シラバス本文（授業サブタイトル・目的と概要・
#   各回の題目）だけを抜いたもの。tools/extract_syllabus_text.py が作る。
#   原文そのものなので courses.json と同じ線の内側に置く
data/syllabus_text.jsonl.gz

# ローカル設定
.env
.dev.vars
*.local.json
# 末尾のスラッシュを付けない。付けるとディレクトリにしか当たらず、
# worktree で本体から張った symlink（`ln -s ../rakutan-db/node_modules .`）が
# `git add -A` ですり抜けて commit に混ざる（2026-08-26 に実際に混ざった）。
node_modules
shots/

# wrangler のローカル実行状態（キャッシュ・ローカルD1など）
.wrangler/
.dev.vars
